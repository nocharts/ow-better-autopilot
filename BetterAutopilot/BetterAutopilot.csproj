<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BetterAutopilot</AssemblyName>
    <RootNamespace>BetterAutopilot</RootNamespace>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <!-- Local installs go straight into the mod manager's OWML folder after each build (skipped where it does not exist, e.g. CI). -->
    <OwmlDir Condition="'$(OwmlDir)' == ''">$(HOME)/.var/app/com.outerwildsmods.owmods_gui/data/OuterWildsModManager/OWML</OwmlDir>
    <ModDir>$(OwmlDir)/Mods/nocharts.BetterAutopilot</ModDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="OuterWildsGameLibs" Version="1.1.16.1372" IncludeAssets="compile" />
    <PackageReference Include="OWML" Version="2.16.3" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="default-config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="InstallMod" AfterTargets="Build" Condition="Exists('$(OwmlDir)')">
    <MakeDir Directories="$(ModDir)" />
    <Copy SourceFiles="$(TargetPath);$(OutDir)manifest.json;$(OutDir)default-config.json" DestinationFolder="$(ModDir)" />
    <Message Importance="high" Text="Installed to $(ModDir)" />
  </Target>

</Project>
